{
  "name": "blueline-darts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ios": "NEXT_PUBLIC_BLUELINE_PLATFORM=ios NEXT_PUBLIC_BLUELINE_FEATURES=${BLUELINE_IOS_FEATURES-profile,sync,devices} next build && cap sync ios",
    "ios": "npm run build:ios && cap open ios",
    "ios:assets": "node scripts/ios-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:relay": "node --test tests/relay/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@scure/base": "1.2.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.1",
    "jsqr": "1.4.0",
    "lucide-react": "^0.454.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "nostr-core": "1.0.6",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "fake-indexeddb": "^6.2.6",
    "playwright": "1.63.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
