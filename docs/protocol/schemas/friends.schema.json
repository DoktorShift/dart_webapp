{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueLine friends record content",
  "$defs": {
    "friend.request": {
      "description": "Asks the addressed profile to be friends; only ever inside a NIP-59 gift wrap",
      "kind": 1180,
      "encryption": "none",
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 140,
          "description": "Plain text, never HTML"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "friend.accept": {
      "description": "Accepts a friend request; only ever inside a NIP-59 gift wrap",
      "kind": 1180,
      "encryption": "none",
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "friend.remove": {
      "description": "Ends a friendship or withdraws a request; only ever inside a NIP-59 gift wrap",
      "kind": 1180,
      "encryption": "none",
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  }
}
