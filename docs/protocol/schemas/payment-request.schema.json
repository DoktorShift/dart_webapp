{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueLine payment-request record content",
  "$defs": {
    "payment.request": {
      "description": "Payment request to a fellow player; only ever inside a NIP-59 gift wrap",
      "kind": 1501,
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000000,
          "description": "Amount in msat, whole sats"
        },
        "invoice": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "pattern": "^ln(bc|tb|bcrt|tbs)[0-9a-z]+$",
          "description": "BOLT11 invoice, lowercase"
        },
        "hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "description": "Payment hash of the invoice; the request's idempotency key"
        },
        "expires": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Request expiry, not after the invoice's"
        },
        "seat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Seat of the requesting player"
        },
        "memo": {
          "type": "string",
          "maxLength": 140,
          "description": "Plain text, never HTML"
        }
      },
      "required": ["amount", "invoice", "hash", "expires", "seat"],
      "additionalProperties": true
    }
  }
}
